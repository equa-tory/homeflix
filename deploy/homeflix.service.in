# Generated by HomeFlix install.sh from deploy/homeflix.service.in -- edit the
# template (or homeflix.env for settings) and re-run ./install.sh, not this copy.
[Unit]
Description=HomeFlix (self-hosted video library)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@APP_DIR@
# All HOMEFLIX_* settings (library path, secret key, allowed hosts, ...) live here.
EnvironmentFile=@APP_DIR@/homeflix.env
# ffmpeg/ffprobe come from the system PATH; the project-local Deno that
# yt-dlp needs is also found by HomeFlix itself, but is listed here for completeness.
Environment=PATH=@APP_DIR@/venv/bin:@APP_DIR@/.deno/bin:/usr/local/bin:/usr/bin:/bin
# --timeout 120: "Fetch list" on a big playlist runs yt-dlp inside a request.
# --worker-class gthread: video streaming holds a connection open for a long time.
# With plain sync workers each stream pins a whole worker (3 viewers = the site
# freezes) and gunicorn SIGKILLs a worker that serves one response past --timeout.
ExecStart=@APP_DIR@/venv/bin/gunicorn config.wsgi:application --bind @BIND@:@PORT@ --workers 3 --worker-class gthread --threads 8 --timeout 120
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
